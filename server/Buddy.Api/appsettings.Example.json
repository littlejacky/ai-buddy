{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": ["http://localhost:5173", "https://localhost:5173"] },
  "AzureRealtime": {
    "Endpoint": "https://YOUR-RESOURCE-NAME.openai.azure.com",
    "ApiKey": "不要写在这里 —— 用 dotnet user-secrets（见 README）",
    "DeploymentName": "YOUR-REALTIME-DEPLOYMENT-NAME",
    "TranscriptionDeploymentName": "可选：转写模型的部署名；不填则界面看不到“你说的话”的文字",
    "DefaultVoice": "marin",
    "DefaultExpiresAfterSeconds": 600,
    "ChildMaxSessionSeconds": 900,
    "AdultMaxSessionSeconds": 0
  }
}
